{
  "name": "ebay-ka-agent",
  "version": "1.0.0",
  "description": "eBay Kleinanzeigen listing monitor",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": "26.13.1"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "NODE_ENV=development node --watch src/server.js",
    "scrape": "node src/scraper/cli.js",
    "check:syntax": "find src -name '*.js' | xargs node --check && node --check public/js/app.js",
    "audit": "npm audit --omit=dev",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "nunjucks": "^3.2.4",
    "playwright": "^1.65.1"
  },
  "devDependencies": {
    "chokidar-hot-reload": "npm:chokidar@^6.0.0"
  }
}
