<div id="item-specs"
  {% if queueEntry and queueEntry.status in ['pending', 'processing'] %}
    hx-get="/items/{{ itemId }}/specs"
    hx-trigger="every 3s"
    hx-swap="outerHTML"
  {% endif %}>

  {% if error %}
    <p class="specs-error">{{ error }}</p>
  {% endif %}

  {% if specs %}
    <table class="specs-table">
      {% if specs.cpu %}
        <tr><th>CPU</th><td>{{ specs.cpu }}{% if specs.cpu_variant %} <span class="specs-variant">{{ specs.cpu_variant }}</span>{% endif %}</td></tr>
      {% endif %}
      {% if specs.gpu %}
        <tr><th>GPU</th><td>{{ specs.gpu }}{% if specs.vram_gb %} {{ specs.vram_gb }} GB VRAM{% endif %}</td></tr>
      {% endif %}
      {% if specs.ram_gb %}
        <tr><th>RAM</th><td>{{ specs.ram_gb }} GB{% if specs.ram_type %} {{ specs.ram_type }}{% endif %}</td></tr>
      {% endif %}
      {% if specs.storage %}
        <tr><th>Storage</th><td>{{ specs.storage }}</td></tr>
      {% endif %}
      {% if specs.motherboard %}
        <tr><th>Mainboard</th><td>{{ specs.motherboard }}</td></tr>
      {% endif %}
      {% if specs.os %}
        <tr><th>OS</th><td>{{ specs.os }}</td></tr>
      {% endif %}
      {% if specs.condition %}
        <tr><th>Condition</th><td>{{ specs.condition }}</td></tr>
      {% endif %}
    </table>
  {% endif %}

  {% if queueEntry and queueEntry.status in ['pending', 'processing'] %}
    <div class="specs-pending">
      <span class="spinner"></span>
      {{ 'Analyzing…' if queueEntry.status == 'processing' else 'Queued…' }}
      {% if queueEntry.queue_left %}
        <span class="specs-queue-left">{{ queueEntry.queue_left }} left</span>
      {% endif %}
    </div>
  {% else %}
    {% if queueEntry and queueEntry.status == 'failed' %}
      <p class="specs-error">Analysis failed: {{ queueEntry.last_error }}</p>
    {% endif %}
    <button class="btn btn-sm {{ 'btn-extract-redo' if specs }}"
            hx-post="/items/{{ itemId }}/extract"
            hx-target="#item-specs"
            hx-swap="outerHTML"
            hx-indicator="#extract-spinner">
      {{ 'Analyze again' if specs else 'Start AI analysis' }}
    </button>
    <span id="extract-spinner" class="htmx-indicator spinner"></span>
  {% endif %}
</div>
