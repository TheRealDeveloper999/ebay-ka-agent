{% if running %}
  <span class="scrape-result scrape-result--running"
        hx-get="/sources/{{ source.id }}/scrape-status"
        hx-trigger="every 2s"
        hx-target="this"
        hx-swap="outerHTML">
    Scraping…
  </span>
{% elif error %}
  <span class="scrape-result scrape-result--error">Fehler: {{ error }}</span>
{% elif stats %}
  <span class="scrape-result scrape-result--ok">
    Fertig — {{ stats.newItems }} neu, {{ stats.changedItems }} geändert, {{ stats.removedItems }} entfernt
  </span>
{% endif %}
