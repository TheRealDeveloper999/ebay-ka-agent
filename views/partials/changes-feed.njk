<div id="changes-feed" class="changes-feed">
  {% if changes.length == 0 %}
    <p class="empty-state">No changes recorded yet.</p>
  {% else %}
    {% for ch in changes %}
      <div class="change-entry{{ ' change-entry--today' if ch.change_type != 'new' and isToday and isToday(ch.detected_at) }}">
        {% if ch.thumbnail_url %}
          <img class="change-thumb" src="{{ ch.thumbnail_url }}" alt="" loading="lazy">
        {% endif %}
        <div class="change-body">
          <div class="change-header">
            <span class="badge {{ changeTypeBadgeClass(ch.change_type) }}">{{ changeTypeLabel(ch.change_type) }}</span>
            <a class="change-title" href="/items/{{ ch.item_id }}">{{ ch.title }}</a>
          </div>
          {% include "partials/change-diff.njk" %}
          <div class="change-meta">
            {% if ch.source_name %}<span>{{ ch.source_name }}</span>{% endif %}
            <time>{{ relativeTime(ch.detected_at) }}</time>
          </div>
        </div>
      </div>
    {% endfor %}
  {% endif %}
</div>
