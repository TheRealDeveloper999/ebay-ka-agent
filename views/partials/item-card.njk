<div class="item-card">
  <div class="item-card__thumb-wrap" title="{{ item.title }}">
    {% if item.card_image_urls and item.card_image_urls.length %}
      <div class="item-card__slider" data-slider aria-label="Images for {{ item.title }}">
        <a class="item-card__thumb-link" href="/items/{{ item.id }}" aria-label="Open {{ item.title }}">
          {% for img in item.card_image_urls %}
            <img class="item-card__thumb item-card__slide {{ 'is-active' if loop.first }}"
                 {% if loop.first %}src="{{ img }}"{% else %}data-src="{{ img }}"{% endif %}
                 alt=""
                 loading="lazy"
                 data-slide-index="{{ loop.index0 }}">
          {% endfor %}
        </a>
        {% if item.card_image_urls.length > 1 %}
          <button class="item-card__slider-btn item-card__slider-btn--prev" type="button" data-slider-prev aria-label="Previous image">‹</button>
          <button class="item-card__slider-btn item-card__slider-btn--next" type="button" data-slider-next aria-label="Next image">›</button>
          <span class="item-card__slider-count" data-slider-count>1/{{ item.card_image_urls.length }}</span>
        {% endif %}
      </div>
    {% else %}
      <a class="item-card__thumb-link" href="/items/{{ item.id }}" aria-label="Open {{ item.title }}">
        <div class="item-card__thumb item-card__thumb--placeholder"></div>
      </a>
    {% endif %}
    {% if item.age %}
      <span class="item-card__age item-card__age--{{ item.age.color }}"
            title="Listed {{ item.age.days }} days ago">{{ item.age.days }}d</span>
    {% endif %}
    <span class="item-card__price">{{ formatPrice(item.price, item.price_text) }}</span>
    {% if item.score !== null and item.score !== undefined %}
      <span class="score-badge score-badge--{{ scoreLabel(item.score) }} score-badge--overlay" title="GPU-Score">{{ item.score }}</span>
    {% endif %}
  </div>
  <a class="item-card__link" href="/items/{{ item.id }}">
    <div class="item-card__body">
      {% set sl = specLine(item.specs) %}
      {% if sl %}
        <div class="item-card__title item-card__title--specs" title="{{ sl }}">{{ sl }}</div>
      {% elif item.queue_status in ['pending', 'processing'] %}
        <div class="item-card__title item-card__title--pending">Analyzing…</div>
      {% else %}
        <div class="item-card__title" title="{{ item.title }}">{{ item.title }}</div>
      {% endif %}
      <div class="item-card__meta">
        {% if item.location %}<span class="item-card__location">{{ item.location }}</span>{% endif %}
      </div>
      <div class="item-card__source">{{ item.source_name }} · {{ relativeTime(item.first_seen_at) }}</div>
    </div>
  </a>
  <div class="item-card__menu">
    <button class="item-card__menu-btn" type="button" aria-label="Options">···</button>
    <ul class="item-card__dropdown" hidden>
      <li>
        <button type="button"
                hx-post="/items/{{ item.id }}/hide"
                hx-target="closest .item-card"
                hx-swap="delete">
          Hide
        </button>
      </li>
    </ul>
  </div>
</div>
