{% extends "layouts/base.njk" %}

{% block title %}Quellen{% endblock %}

{% block content %}
<div class="page-header">
  <h1>Quellen</h1>
  <a class="btn btn-primary" href="/sources/new">+ Neue Quelle</a>
</div>

{% if sources.length == 0 %}
  <div class="empty-state-box">
    <p>Noch keine Quellen konfiguriert.</p>
    <a class="btn btn-primary" href="/sources/new">Erste Quelle hinzufügen</a>
  </div>
{% else %}
  <div class="table-wrapper">
    <table class="table">
      <thead>
        <tr>
          <th>Name</th>
          <th>URL</th>
          <th>Anzeigen</th>
          <th>Zuletzt gescraped</th>
          <th>Intervall</th>
          <th>Aktionen</th>
        </tr>
      </thead>
      {% for source in sources %}
        {% include "partials/source-row.njk" %}
      {% endfor %}
    </table>
  </div>
{% endif %}
{% endblock %}
