{% extends "layouts/base.njk" %}

{% block title %}Sources{% endblock %}

{% block content %}
<div class="page-header">
  <h1>Sources</h1>
  <a class="btn btn-primary" href="/sources/new">+ New source</a>
</div>

{% if sources.length == 0 %}
  <div class="empty-state-box">
    <p>No sources configured yet.</p>
    <a class="btn btn-primary" href="/sources/new">Add first source</a>
  </div>
{% else %}
  <div class="table-wrapper">
    <table class="table sources-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>URL</th>
          <th>Listings</th>
          <th>Last scraped</th>
          <th>Interval</th>
          <th>Actions</th>
        </tr>
      </thead>
      {% for source in sources %}
        {% include "partials/source-row.njk" %}
      {% endfor %}
    </table>
  </div>
{% endif %}
{% endblock %}
