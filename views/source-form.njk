{% extends "layouts/base.njk" %}

{% block title %}{{ title }}{% endblock %}

{% block content %}
<div class="page-header">
  <h1>{{ title }}</h1>
  <a class="btn" href="/sources">← Back</a>
</div>

{% if errors.length %}
  <div class="flash flash-error">
    <ul>{% for e in errors %}<li>{{ e }}</li>{% endfor %}</ul>
  </div>
{% endif %}

<form class="form-card" method="POST" action="{{ action }}">
  <div class="form-group">
    <label for="name">Name <span class="required">*</span></label>
    <input type="text" id="name" name="name" value="{{ source.name }}" required placeholder="e.g. cars Munich">
  </div>

  <div class="form-group">
    <label for="url">Category URL <span class="required">*</span></label>
    <input type="url" id="url" name="url" value="{{ source.url }}" required
           placeholder="https://www.kleinanzeigen.de/s-autos/c216">
    <small>Full URL of a category or search page on kleinanzeigen.de</small>
  </div>

  <div class="form-row">
    <div class="form-group">
      <label for="interval">Interval (minutes) <span class="required">*</span></label>
      <input type="number" id="interval" name="interval" value="{{ source.interval or 30 }}" min="5" max="1440">
    </div>

    <div class="form-group form-group--checkbox">
      <label>
        <input type="checkbox" name="active" {{ 'checked' if source.active != 0 }}>
        >Active<
      </label>
    </div>
  </div>

  <fieldset class="form-fieldset">
    <legend>Filter (optional)</legend>
    <div class="form-group">
      <label for="keyword">Keyword</label>
      <input type="text" id="keyword" name="keyword" value="{{ source.keyword }}" placeholder="z.B. BMW, iPhone 14">
    </div>
    <div class="form-row">
      <div class="form-group">
        <label for="min_price">Minimum price (€)</label>
        <input type="number" id="min_price" name="min_price" value="{{ source.min_price }}" min="0" step="0.01">
      </div>
      <div class="form-group">
        <label for="max_price">Maximum price (€)</label>
        <input type="number" id="max_price" name="max_price" value="{{ source.max_price }}" min="0" step="0.01">
      </div>
    </div>
  </fieldset>

  <div class="form-actions">
    <button type="submit" class="btn btn-primary">Save</button>
    <a class="btn" href="/sources">Cancel</a>
  </div>
</form>
{% endblock %}

{% block scripts %}
<script>
(function () {
  const urlEl = document.getElementById('url');
  const minEl = document.getElementById('min_price');
  const maxEl = document.getElementById('max_price');

  // KA price URL segment format: /preis:MIN:MAX/ (colons, either side can be empty)
  const PRICE_RE = /\/preis:(\d*):(\d*)/;

  function parsePrice(url) {
    const m = url.match(PRICE_RE);
    return m ? { min: m[1], max: m[2] } : null;
  }

  function buildPriceSegment(min, max) {
    return (min || max) ? `/preis:${min}:${max}` : '';
  }

  // URL → price fields
  urlEl.addEventListener('input', function () {
    const p = parsePrice(this.value);
    if (!p) return;
    minEl.value = p.min;
    maxEl.value = p.max;
  });

  // Price fields → URL
  function syncUrlFromPrice() {
    let url = urlEl.value.trim();
    if (!url) return;
    const min = minEl.value.trim();
    const max = maxEl.value.trim();
    const segment = buildPriceSegment(min, max);
    if (PRICE_RE.test(url)) {
      // Replace existing segment (or remove if both empty)
      url = url.replace(PRICE_RE, segment);
    } else if (segment) {
      // Insert before the last path segment (e.g. k0c228l1253r30), or append
      url = url.replace(/\/([^/]+)\/?$/, `${segment}/$1`);
    }
    urlEl.value = url;
  }

  minEl.addEventListener('input', syncUrlFromPrice);
  maxEl.addEventListener('input', syncUrlFromPrice);
})();
</script>
{% endblock %}
