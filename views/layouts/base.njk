<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% block title %}KA Agent{% endblock %} — eBay Kleinanzeigen Monitor</title>
  <link rel="stylesheet" href="/css/reset.css">
  <link rel="stylesheet" href="/css/app.css">
  {% block head %}{% endblock %}
</head>
<body>
  <nav class="nav">
    <a class="nav-brand" href="/">KA Agent</a>
    <ul class="nav-links">
      <li><a href="/" class="{{ 'active' if page == 'dashboard' }}">Dashboard</a></li>
      <li><a href="/sources" class="{{ 'active' if page == 'sources' }}">Quellen</a></li>
    </ul>
  </nav>

  <main class="main">
    {% if flash %}
      <div class="flash flash-{{ flashType }}">{{ flash }}</div>
    {% endif %}

    {% block content %}{% endblock %}
  </main>

  <script src="https://unpkg.com/htmx.org@2.0.4" crossorigin="anonymous"></script>
  <script src="/js/app.js"></script>
  {% block scripts %}{% endblock %}
</body>
</html>
