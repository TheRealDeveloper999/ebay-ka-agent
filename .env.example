PORT=3000
DB_PATH=./data/ka-agent.db
LOG_LEVEL=info
PLAYWRIGHT_HEADLESS=true
MAX_PAGES_PER_SOURCE=3
MIN_SCRAPE_INTERVAL_MINUTES=5

# Multiple keys rotate automatically when one hits the daily limit.
# All conventions below are supported; use one style consistently.
OPENROUTER_API_KEYS=key1,key2,key3
OPENROUTER_API_KEY=your-key-here
OPENROUTER_API_KEY_1=key1
OPENROUTER_API_KEY_2=key2
OPENROUTER_API_KEY_3=key3
OPENROUTER_MODEL=qwen/qwen3-235b-a22b-2507
